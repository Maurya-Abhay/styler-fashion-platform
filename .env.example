# Local development default. Set both variables to your real HTTPS domain for production.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_MAX_POOL_SIZE=10
MONGODB_SELECTION_TIMEOUT_MS=10000

# Security (use long, random values; never commit real secrets)
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
OTP_PEPPER=replace-with-a-different-random-secret-at-least-32-characters
RATE_LIMIT_PEPPER=replace-with-another-random-secret-at-least-32-characters
BCRYPT_ROUNDS=12
SESSION_TTL_DAYS=30
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ZeptoMail SMTP (server only)
ZEPTOMAIL_SMTP_HOST=smtp.zeptomail.in
ZEPTOMAIL_SMTP_PORT=587
ZEPTOMAIL_SMTP_USER=
ZEPTOMAIL_SMTP_PASSWORD=
ZEPTOMAIL_FROM_EMAIL=verified-sender@example.com
ZEPTOMAIL_FROM_NAME="Ricoz Innovation"
# Inbox for website contact-form messages; defaults to ZEPTOMAIL_FROM_EMAIL.
ZEPTOMAIL_CONTACT_TO=

# Razorpay (server only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_API_BASE=https://api.razorpay.com/v1

# ImageKit (never expose PRIVATE_KEY in client code)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Web Push (generate VAPID keys and keep private key on server)
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:notifications@example.com

# Scheduled jobs (server only; use a long random secret)
CRON_SECRET=replace-with-a-random-secret-at-least-32-characters

# One-time admin bootstrap (set only when running npm run create-admin)
# STYLER_ADMIN_NAME=Styler Admin
# STYLER_ADMIN_EMAIL=admin@example.com
# STYLER_ADMIN_PHONE=+91XXXXXXXXXX
# STYLER_ADMIN_PASSWORD=replace-with-a-strong-password-at-least-12-characters
